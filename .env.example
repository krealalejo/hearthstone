# Real values go in .env (gitignored — never commit .env)
# Copy this file to .env and fill in your actual values before running nuxt dev.

NUXT_MONGO_URI=mongodb://localhost:27017/hearth
NUXT_JWT_SECRET=change-me-in-production-min-32-chars

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match NUXT_GOOGLE_REDIRECT_URI exactly
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
